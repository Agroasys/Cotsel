{
  "name": "treasury",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "mkdir -p dist/database && cp src/database/schema.sql src/database/002_canonical_monetary_amounts.sql src/database/003_maker_checker_actor_chain.sql src/database/004_canonical_chain_evidence.sql src/database/005_ingestion_freshness_worker.sql src/database/006_provider_handoff_authority.sql src/database/migrations.json dist/database/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "ingest:once": "ts-node src/server.ts --ingest-once"
  },
  "dependencies": {
    "@agroasys/sdk": "workspace:*",
    "@agroasys/shared-db": "^1.0.0",
    "@agroasys/shared-edge": "^1.0.0",
    "@agroasys/shared-auth": "^1.0.0",
    "@agroasys/shared-http": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": ">=6.0.2 <6.1.0"
  },
  "license": "Apache-2.0"
}
