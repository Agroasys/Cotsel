  {
    "record_type": "constraint",
    "identity": "public.oracle_triggers.check_confirmation_stage",
    "definition": "type=c,definition=CHECK (confirmation_stage IS NULL OR (confirmation_stage::text = ANY (ARRAY['INDEXED'::character varying, 'SAFE'::character varying, 'FINALIZED'::character varying]::text[])))"
  },
  {
    "record_type": "constraint",
    "identity": "public.oracle_triggers.check_error_type",
    "definition": "type=c,definition=CHECK (error_type::text = ANY (ARRAY['VALIDATION'::character varying, 'NETWORK'::character varying, 'CONTRACT'::character varying, 'TERMINAL'::character varying, 'INDEXER_LAG'::character varying]::text[]))"
  },
  {
    "record_type": "constraint",
    "identity": "public.oracle_triggers.check_status",
    "definition": "type=c,definition=CHECK (status::text = ANY (ARRAY['PENDING'::character varying, 'EXECUTING'::character varying, 'SUBMITTED'::character varying, 'CONFIRMED'::character varying, 'FAILED'::character varying, 'EXHAUSTED_NEEDS_REDRIVE'::character varying, 'TERMINAL_FAILURE'::character varying, 'PENDING_APPROVAL'::character varying, 'REJECTED'::character varying]::text[]))"
  },
  {
    "record_type": "constraint",
    "identity": "public.oracle_triggers.check_trigger_type",
    "definition": "type=c,definition=CHECK (trigger_type::text = ANY (ARRAY['RELEASE_STAGE_1'::character varying, 'CONFIRM_ARRIVAL'::character varying, 'CONFIRM_INSPECTION_AVAILABLE_STANDARD'::character varying, 'CONFIRM_INSPECTION_AVAILABLE_PACKAGED_LOCAL'::character varying, 'FINALIZE_AFTER_INSPECTION_ACCEPTANCE'::character varying, 'FINALIZE_TRADE'::character varying]::text[]))"
  },
  {
