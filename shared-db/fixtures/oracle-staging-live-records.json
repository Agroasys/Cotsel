  },
  {
    "record_type": "function",
    "identity": "public.current_app_service_name()",
    "definition": "CREATE OR REPLACE FUNCTION public.current_app_service_name()\n RETURNS text\n LANGUAGE sql\n STABLE\nAS $function$\n    SELECT COALESCE(current_setting('app.service_name', true), '');\n$function$\n"
  },
  {
