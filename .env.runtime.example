# Runtime identity is explicit. Deployed AWS tasks use NODE_ENV=production and
# COTSEL_ENVIRONMENT=staging; local Compose uses the values below.
NODE_ENV=development
COTSEL_ENVIRONMENT=local

GATEWAY_INDEXER_GRAPHQL_URL=http://indexer-graphql:4350/graphql
GATEWAY_INDEXER_REQUEST_TIMEOUT_MS=5000
GATEWAY_SETTLEMENT_RUNTIME=base-sepolia
GATEWAY_RPC_URL=
GATEWAY_RPC_FALLBACK_URLS=
# Optional: require N-provider agreement for reads (default 1 = first answer wins).
# Clamped to the number of configured endpoints, so it can never block startup.
GATEWAY_RPC_QUORUM=
GATEWAY_CHAIN_ID=84532
GATEWAY_EXPLORER_BASE_URL=https://sepolia-explorer.base.org/tx/

# In-network GraphQL endpoints (never localhost inside containers)
RECONCILIATION_INDEXER_GRAPHQL_URL=http://indexer-graphql:4350/graphql
TREASURY_INDEXER_GRAPHQL_URL=http://indexer-graphql:4350/graphql
ORACLE_INDEXER_GRAPHQL_URL=http://indexer-graphql:4350/graphql

# Active Base Sepolia managed-provider inputs.
# INDEXER_GATEWAY_URL is optional when the indexer runs directly against RPC.
INDEXER_GATEWAY_URL=
INDEXER_RPC_ENDPOINT=
# Optional comma-separated fallback RPC endpoints (priority order). The indexer
# can only use one URL at a time, so it picks the first reachable one at startup.
INDEXER_RPC_FALLBACK_ENDPOINTS=
# Set this from the independently reviewed canonical deployment report.
INDEXER_START_BLOCK=
INDEXER_RATE_LIMIT=10
INDEXER_RPC_CAPACITY=
INDEXER_RPC_MAX_BATCH_CALL_SIZE=
INDEXER_RPC_REQUEST_TIMEOUT_MS=
INDEXER_RPC_RETRY_ATTEMPTS=
INDEXER_RPC_HEAD_POLL_INTERVAL_MS=
INDEXER_RPC_INGEST_DISABLED=false
INDEXER_RPC_BLOCK_SPLIT_SIZE=10
FINALITY_CONFIRMATION_BLOCKS=1
INDEXER_GRAPHQL_PORT=4350
INDEXER_CHAIN_ID=84532
INDEXER_DB_SSL_MODE=disable
# Poison-log preflight. Pin these from the reviewed deployment report to make
# a contract redeploy or ABI change fail startup instead of silently
# reprojecting a different contract. Both are REQUIRED, along with an enabled
# notification webhook, when COTSEL_ENVIRONMENT is staging or production.
INDEXER_EXPECTED_CONTRACT_CODEHASH=
INDEXER_EXPECTED_ABI_FINGERPRINT=
# Historical eth_getCode at START_BLOCK. Set false only for a non-archive RPC.
INDEXER_VERIFY_START_BLOCK_CODE=true

# Chain context used by validation reporting
STAGING_E2E_REAL_NETWORK_NAME='Base Sepolia'
STAGING_E2E_REAL_CHAIN_ID=84532

# Reconciliation/oracle pilot runtime (managed primary + independent fallback)
RECONCILIATION_SETTLEMENT_RUNTIME=base-sepolia
RECONCILIATION_RPC_URL=
RECONCILIATION_RPC_FALLBACK_URLS=
# Optional RPC failover tuning (defaults: quorum 1, stall 1500ms).
RECONCILIATION_RPC_QUORUM=
RECONCILIATION_RPC_STALL_TIMEOUT_MS=
RECONCILIATION_CHAIN_ID=84532
ORACLE_SETTLEMENT_RUNTIME=base-sepolia
ORACLE_RPC_URL=
ORACLE_RPC_FALLBACK_URLS=
# Optional RPC failover tuning (defaults: quorum 1, stall 1500ms).
ORACLE_RPC_QUORUM=
ORACLE_RPC_STALL_TIMEOUT_MS=
ORACLE_CHAIN_ID=84532

# Enforce non-localhost indexer URL when reconciliation runs in containerized staging profile
RECONCILIATION_REQUIRE_CONTAINER_SAFE_INDEXER_URL=true

# Optional strictness for release candidates
# When true, the gate fails if indexer has zero trades for the configured contract scope.
STAGING_E2E_REAL_REQUIRE_INDEXED_DATA=false
STAGING_E2E_REAL_DYNAMIC_START_BLOCK=true
STAGING_E2E_REAL_GATE_RPC_URL=
STAGING_E2E_REAL_START_BLOCK_BACKOFF=250
STAGING_E2E_REAL_LAG_WARMUP_SECONDS=180
STAGING_E2E_REAL_LAG_POLL_SECONDS=5


# Replace with deployed addresses for full staging parity.
# Quotes are optional for values without whitespace; the strict parser never
# executes this file as shell code.
RECONCILIATION_ESCROW_ADDRESS=
RECONCILIATION_USDC_ADDRESS=
ORACLE_ESCROW_ADDRESS=
ORACLE_USDC_ADDRESS=
GATEWAY_ESCROW_ADDRESS=
GATEWAY_USDC_ADDRESS=
INDEXER_CONTRACT_ADDRESS=

# Gate thresholds
STAGING_E2E_MAX_INDEXER_LAG_BLOCKS=500
STAGING_E2E_DRIFT_SUMMARY_LIMIT=10

# Asset conversion fee-path validation (set tx hashes after running live probe)
STAGING_E2E_REAL_FEE_PATH_EXPECTED_BEHAVIOR=usdc-preferred
STAGING_E2E_REAL_FEE_PATH_ALLOW_NATIVE_FALLBACK=true
STAGING_E2E_REAL_FEE_PATH_CREATE_TX_HASH=
STAGING_E2E_REAL_FEE_PATH_SETTLEMENT_TX_HASHES=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
REDIS_PORT=6379

AUTH_DB_NAME=
RICARDIAN_DB_NAME=
TREASURY_DB_NAME=
RECONCILIATION_DB_NAME=
ORACLE_DB_NAME=
INDEXER_DB_NAME=
GATEWAY_DB_NAME=

AUTH_PORT=3005
RICARDIAN_PORT=3100
TREASURY_PORT=3200
ORACLE_PORT=3001
GATEWAY_PORT=3600
RECONCILIATION_HEALTH_PORT=9090

AUTH_SESSION_TTL_SECONDS=3600
LEGACY_WALLET_LOGIN_ENABLED=false

GATEWAY_AUTH_BASE_URL=http://auth:3005
GATEWAY_AUTH_REQUEST_TIMEOUT_MS=5000
GATEWAY_ORACLE_BASE_URL=http://oracle:3001
GATEWAY_TREASURY_BASE_URL=http://treasury:3200
GATEWAY_RECONCILIATION_BASE_URL=http://reconciliation:9090
GATEWAY_RICARDIAN_BASE_URL=http://ricardian:3100

RECONCILIATION_ENABLED=true
RECONCILIATION_DAEMON_INTERVAL_MS=60000
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_MAX_TRADES_PER_RUN=1000

ORACLE_RETRY_ATTEMPTS=3
ORACLE_RETRY_DELAY=1000
ORACLE_MANUAL_APPROVAL_ENABLED=false

TREASURY_INGEST_BATCH_SIZE=100
TREASURY_INGEST_MAX_EVENTS=2000

TREASURY_AUTH_ENABLED=false
TREASURY_API_KEYS_JSON=
TREASURY_AUTH_MAX_SKEW_SECONDS=300
TREASURY_AUTH_NONCE_TTL_SECONDS=600
TREASURY_NONCE_STORE=postgres
TREASURY_NONCE_REDIS_URL=
TREASURY_NONCE_TTL_SECONDS=600
TREASURY_RATE_LIMIT_ENABLED=true
TREASURY_RATE_LIMIT_REDIS_URL=redis://redis:6379

RICARDIAN_AUTH_ENABLED=false
RICARDIAN_API_KEYS_JSON=
RICARDIAN_AUTH_MAX_SKEW_SECONDS=300
RICARDIAN_AUTH_NONCE_TTL_SECONDS=600
RICARDIAN_NONCE_STORE=postgres
RICARDIAN_NONCE_REDIS_URL=
RICARDIAN_NONCE_TTL_SECONDS=600
RICARDIAN_RATE_LIMIT_ENABLED=false
RICARDIAN_RATE_LIMIT_REDIS_URL=

GATEWAY_ENABLE_MUTATIONS=true
GATEWAY_WRITE_ALLOWLIST=
GATEWAY_COMMIT_SHA=staging-manual
GATEWAY_BUILD_TIME=
GATEWAY_RPC_READ_TIMEOUT_MS=8000
GATEWAY_DOWNSTREAM_READ_RETRY_BUDGET=1
GATEWAY_DOWNSTREAM_MUTATION_RETRY_BUDGET=0
GATEWAY_DOWNSTREAM_READ_TIMEOUT_MS=5000
GATEWAY_DOWNSTREAM_MUTATION_TIMEOUT_MS=8000
GATEWAY_EXECUTOR_TIMEOUT_MS=45000
GATEWAY_ALLOW_INSECURE_DOWNSTREAM_AUTH=false

ORACLE_API_KEY=
ORACLE_HMAC_SECRET=
TREASURY_HMAC_SECRET=
RICARDIAN_HMAC_SECRET=
ORACLE_NOTIFICATIONS_ENABLED=false
ORACLE_NOTIFICATIONS_WEBHOOK_URL=
ORACLE_NOTIFICATIONS_COOLDOWN_MS=300000
ORACLE_NOTIFICATIONS_REQUEST_TIMEOUT_MS=5000
RECONCILIATION_NOTIFICATIONS_ENABLED=false
RECONCILIATION_NOTIFICATIONS_WEBHOOK_URL=
RECONCILIATION_NOTIFICATIONS_COOLDOWN_MS=300000
RECONCILIATION_NOTIFICATIONS_REQUEST_TIMEOUT_MS=5000
INDEXER_NOTIFICATIONS_ENABLED=false
INDEXER_NOTIFICATIONS_WEBHOOK_URL=
INDEXER_NOTIFICATIONS_COOLDOWN_MS=300000
INDEXER_NOTIFICATIONS_REQUEST_TIMEOUT_MS=5000

ORACLE_EXPLORER_BASE_URL=https://sepolia-explorer.base.org/tx/
RECONCILIATION_EXPLORER_BASE_URL=https://sepolia-explorer.base.org/tx/

# Oracle signer custody. Default raw_private_key uses ORACLE_PRIVATE_KEY below.
# Set kms for direct IAM-authenticated AWS KMS signing. Set mpc for an HTTPS
# signer service. ORACLE_PRIVATE_KEY is rejected in either managed mode.
ORACLE_SIGNER_CUSTODY_MODE=raw_private_key
ORACLE_KMS_KEY_ID=
ORACLE_KMS_EXPECTED_ADDRESS=
ORACLE_MANAGED_SIGNER_URL=
ORACLE_MANAGED_SIGNER_API_KEY=
ORACLE_MANAGED_SIGNER_REQUEST_TIMEOUT_MS=5000
ORACLE_PRIVATE_KEY=
TRUSTED_SESSION_EXCHANGE_ENABLED=true
TRUSTED_SESSION_EXCHANGE_API_KEYS_JSON=
TRUSTED_SESSION_EXCHANGE_MAX_SKEW_SECONDS=300
TRUSTED_SESSION_EXCHANGE_NONCE_TTL_SECONDS=600
GATEWAY_SETTLEMENT_INGRESS_ENABLED=true
GATEWAY_SETTLEMENT_SERVICE_API_KEYS_JSON=
GATEWAY_SETTLEMENT_SERVICE_AUTH_MAX_SKEW_SECONDS=300
GATEWAY_SETTLEMENT_SERVICE_AUTH_NONCE_TTL_SECONDS=600
GATEWAY_SETTLEMENT_CALLBACK_ENABLED=false

# Staging DB role compatibility for compose initialization and migration jobs.
# Runtime services receive only their *_DB_RUNTIME_* credentials.
AUTH_DB_RUNTIME_USER=
AUTH_DB_RUNTIME_PASSWORD=
AUTH_DB_MIGRATION_USER=
AUTH_DB_MIGRATION_PASSWORD=

GATEWAY_DB_RUNTIME_USER=
GATEWAY_DB_RUNTIME_PASSWORD=
GATEWAY_DB_MIGRATION_USER=
GATEWAY_DB_MIGRATION_PASSWORD=

ORACLE_DB_RUNTIME_USER=
ORACLE_DB_RUNTIME_PASSWORD=
ORACLE_DB_MIGRATION_USER=
ORACLE_DB_MIGRATION_PASSWORD=

INDEXER_DB_RUNTIME_USER=
INDEXER_DB_RUNTIME_PASSWORD=
INDEXER_DB_MIGRATION_USER=
INDEXER_DB_MIGRATION_PASSWORD=
INDEXER_DB_READER_USER=
INDEXER_DB_READER_PASSWORD=

TREASURY_DB_RUNTIME_USER=
TREASURY_DB_RUNTIME_PASSWORD=
TREASURY_DB_MIGRATION_USER=
TREASURY_DB_MIGRATION_PASSWORD=

RECONCILIATION_DB_RUNTIME_USER=
RECONCILIATION_DB_RUNTIME_PASSWORD=
RECONCILIATION_DB_MIGRATION_USER=
RECONCILIATION_DB_MIGRATION_PASSWORD=

RICARDIAN_DB_RUNTIME_USER=
RICARDIAN_DB_RUNTIME_PASSWORD=
RICARDIAN_DB_MIGRATION_USER=
RICARDIAN_DB_MIGRATION_PASSWORD=

AUTH_CORS_ALLOWED_ORIGINS=
AUTH_CORS_ALLOW_NO_ORIGIN=false
AUTH_RATE_LIMIT_ENABLED=false

GATEWAY_CORS_ALLOWED_ORIGINS=
GATEWAY_CORS_ALLOW_NO_ORIGIN=false
GATEWAY_RATE_LIMIT_ENABLED=false
AUTH_ADMIN_CONTROL_ENABLED=false
AUTH_ADMIN_CONTROL_ALLOWED_API_KEY_IDS=
AUTH_ADMIN_CONTROL_API_KEYS_JSON=
AUTH_ADMIN_CONTROL_MAX_SKEW_SECONDS=300
AUTH_ADMIN_CONTROL_NONCE_TTL_SECONDS=600
AUTH_ADMIN_BREAK_GLASS_MAX_TTL_SECONDS=3600

AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379
AUTH_RATE_LIMIT_FAIL_OPEN=false

ORACLE_RATE_LIMIT_ENABLED=false
ORACLE_RATE_LIMIT_REDIS_URL=redis://redis:6379
ORACLE_CORS_ALLOWED_ORIGINS=
ORACLE_CORS_ALLOW_NO_ORIGIN=false

GATEWAY_RATE_LIMIT_REDIS_URL=redis://redis:6379
GATEWAY_RATE_LIMIT_FAIL_OPEN=false

RICARDIAN_CORS_ALLOWED_ORIGINS=
RICARDIAN_CORS_ALLOW_NO_ORIGIN=false
TREASURY_CORS_ALLOWED_ORIGINS=
TREASURY_CORS_ALLOW_NO_ORIGIN=false

# Gateway service-auth, notifications, and gasless-execution controls.
GATEWAY_GOVERNANCE_QUEUE_TTL_SECONDS=86400
GATEWAY_EXECUTOR_PRIVATE_KEY=
GATEWAY_GASLESS_EXECUTION_ENABLED=false
GATEWAY_GASLESS_EXECUTOR_PRIVATE_KEY=
GATEWAY_GASLESS_SIGNER_CUSTODY_MODE=raw_private_key
GATEWAY_GASLESS_KMS_KEY_ID=
GATEWAY_GASLESS_KMS_EXPECTED_ADDRESS=
GATEWAY_GASLESS_MANAGED_SIGNER_URL=
GATEWAY_GASLESS_MANAGED_SIGNER_API_KEY=
GATEWAY_GASLESS_MANAGED_SIGNER_REQUEST_TIMEOUT_MS=5000
GATEWAY_GASLESS_BROADCAST_PAUSED=false
GATEWAY_GASLESS_REQUIRE_RPC_FALLBACK=false
GATEWAY_GASLESS_MAX_GAS_LIMIT=1500000
GATEWAY_GASLESS_MAX_FEE_PER_GAS_WEI=50000000000
GATEWAY_GASLESS_MAX_NATIVE_COST_WEI=100000000000000000
GATEWAY_GASLESS_MIN_EXECUTOR_BALANCE_WEI=0
GATEWAY_GASLESS_LOW_BALANCE_ALERT_WEI=0
GATEWAY_GASLESS_CAPACITY_TARGET_TX_PER_DAY=500
GATEWAY_GASLESS_CAPACITY_BURST_MULTIPLIER_BASIS_POINTS=40000
GATEWAY_GASLESS_CAPACITY_SAFETY_MARGIN_BASIS_POINTS=12500
GATEWAY_GASLESS_CAPACITY_FAIL_CLOSED=false
GATEWAY_GASLESS_REQUEST_MAX_TTL_SECONDS=900
GATEWAY_GASLESS_STUCK_QUEUE_THRESHOLD_MS=300000
GATEWAY_GASLESS_RECEIPT_TIMEOUT_MS=120000
GATEWAY_GASLESS_OUTCOME_RECONCILIATION_INTERVAL_MS=5000
GATEWAY_IDEMPOTENCY_LEASE_DURATION_MS=300000
GATEWAY_GASLESS_REPEATED_FAILURE_ALERT_THRESHOLD=3
GATEWAY_NOTIFICATIONS_BASE_URL=
GATEWAY_ORACLE_SERVICE_API_KEY=
GATEWAY_ORACLE_SERVICE_API_SECRET=
GATEWAY_TREASURY_SERVICE_API_KEY=
GATEWAY_TREASURY_SERVICE_API_SECRET=
GATEWAY_RICARDIAN_SERVICE_API_KEY=
GATEWAY_RICARDIAN_SERVICE_API_SECRET=

# Local and controlled-pilot evidence inputs. Private values remain blank in
# the checked-in template and belong only in the ignored runtime file.
LOCAL_DEV_FEE_PATH_EXPECTED_BEHAVIOR=native-fallback
LOCAL_DEV_FEE_PATH_ALLOW_NATIVE_FALLBACK=true
LOCAL_DEV_FEE_PATH_CREATE_TX_HASH=
LOCAL_DEV_FEE_PATH_SETTLEMENT_TX_HASHES=
PILOT_DISPUTE_APPROVER_PRIVATE_KEYS_JSON=[]
PILOT_NATIVE_TOKEN_USD_PRICE_USD=
